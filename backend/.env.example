# ProtectIci : API Laravel. Placeholders uniquement, JAMAIS de secret réel ici (security.md §4).
APP_NAME=ProtectIci
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# Proxies de confiance (Cloudflare) : liste d'IP/CIDR séparées par des virgules, ou "*" derrière un proxy unique maîtrisé.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# PostgreSQL + PostGIS (jamais SQLite)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=protectici_dev
DB_USERNAME=change_me
DB_PASSWORD=change_me
DB_SSLMODE=prefer

# Sessions / Sanctum SPA (cookies httpOnly)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ADMIN_LIFETIME=30
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_COOKIE=protectici_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Hash des mots de passe
HASH_DRIVER=argon2id

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail : "log" en local ; "resend" en staging/production (installer resend/resend-php)
MAIL_MAILER=log
# Local seulement : true affiche les liens signés dans storage/logs (jamais en staging/production)
MAIL_LOG_LINKS=false
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Anti-spam Cloudflare Turnstile (false en local et en test)
TURNSTILE_ENABLED=false
TURNSTILE_SECRET_KEY=

# Géocodage Nominatim (OSM) : User-Agent identifiable obligatoire
NOMINATIM_USER_AGENT="ProtectIci/1.0 (contact: change_me)"

# Secret HMAC pour les ip_hash (formulaires publics, compteur de vues)
IP_HASH_SECRET=change_me

# Stockage S3-compatible (staging/production, ex. Cloudflare R2)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true
