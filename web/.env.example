# Copier vers .env.local. Placeholders uniquement : jamais de secret dans une variable NEXT_PUBLIC_*.

# URL publique de l'API Laravel (même domaine parent que le site pour les cookies Sanctum).
NEXT_PUBLIC_API_URL=http://localhost:8000
# 1 = données factices locales (aucun backend requis), 0 = vraie API.
NEXT_PUBLIC_USE_MOCKS=0
# URL publique du site (sitemap, métadonnées, liens de partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = indexation autorisée (production uniquement). 0 = noindex (staging, local).
NEXT_PUBLIC_ALLOW_INDEXING=0

# --- Variables serveur uniquement (non publiques) ---
# URL de l'API vue depuis le serveur Next (réseau Docker interne). Par défaut : NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Nom du cookie de session Laravel (pour le confort UX du proxy /admin et /compte).
SESSION_COOKIE_NAME=protectici_session
