# Copier vers .env.local. Placeholders uniquement : jamais de secret dans une variable NEXT_PUBLIC_*.

# NEXT_PUBLIC_* : inlinées au BUILD (Docker : build-args). Les changer impose un rebuild.
# URL publique de l'API Laravel (même domaine parent que le site pour les cookies Sanctum).
NEXT_PUBLIC_API_URL=http://localhost:8000
# 1 = données factices locales (aucun backend requis), 0 = vraie API.
NEXT_PUBLIC_USE_MOCKS=0
# URL publique du site (sitemap, métadonnées, liens de partage).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 1 = indexation autorisée (production uniquement). 0 = noindex (staging, local).
NEXT_PUBLIC_ALLOW_INDEXING=0

# Clé de SITE Cloudflare Turnstile (publique). Vide = anti-robot désactivé et script Cloudflare jamais chargé.
# La clé SECRÈTE reste côté API Laravel (jamais ici).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Origines supplémentaires autorisées pour les images/médias (CSP img-src), séparées par des virgules ou des espaces :
# domaine du bucket R2/CDN (ex. https://medias.protectici.ci). Seules les origines https sont retenues.
NEXT_PUBLIC_MEDIA_ORIGINS=

# Fond de carte : modèle https avec {z}/{x}/{y} (fournisseur OSM à quota, ex. MapTiler/Stadia). Vide ou invalide =
# tuiles OpenStreetMap publiques (usage limité). Son origine est ajoutée à la CSP img-src.
NEXT_PUBLIC_TILE_URL=
# Attribution du fournisseur, affichée après « © OpenStreetMap » (toujours présent).
NEXT_PUBLIC_TILE_ATTRIBUTION=

# Photo d'arrière-plan du hero de l'accueil (sous voile bleu). URL https absolue ou chemin local (/hero.webp).
# Vide = aplat bleu seul. Son ORIGINE est ajoutée automatiquement à la CSP img-src (inutile de la répéter
# dans NEXT_PUBLIC_MEDIA_ORIGINS). Photo d'illustration en local : https://images.unsplash.com/... ;
# photo définitive à fournir par ProtectIci avant la mise en ligne.
NEXT_PUBLIC_HERO_IMAGE_URL=
# Crédit affiché en bas à droite de la photo (ex. « Photo : Nom · Source »). Vide = aucun crédit affiché.
NEXT_PUBLIC_HERO_IMAGE_CREDIT=

# --- Variables serveur uniquement (non publiques) ---
# RUNTIME. URL de l'API vue depuis le serveur Next (Docker : http://backend:8080). Par défaut : NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Nom du cookie de session Laravel (pour le confort UX du proxy /admin et /compte).
SESSION_COOKIE_NAME=protectici_session

# SERVEUR uniquement (jamais NEXT_PUBLIC_*) : même valeur que SSR_SHARED_SECRET côté backend.
SSR_SHARED_SECRET=
