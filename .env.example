# Variables de la stack Docker (docker-compose.prod.yml), à saisir dans l'onglet « Environment » de Dockploy.
# PLACEHOLDERS UNIQUEMENT : aucun secret réel dans le repo. Domaine fictif : exemple.ci (à remplacer).
# Valeurs contenant # ou caractères spéciaux : les mettre entre guillemets.
# Détail et procédure : docs/deploiement.md.

# --- Application -------------------------------------------------------------
APP_ENV=production                 # production | staging (APP_DEBUG est forcé à false)
APP_KEY=base64:change_me           # php artisan key:generate --show ; unique par environnement
APP_URL=https://api.exemple.ci
FRONTEND_URL=https://exemple.ci
# Plages Cloudflare + réseau Docker (voir docs/deploiement.md §7) ; "*" seulement derrière un proxy maîtrisé.
TRUSTED_PROXIES=*
IP_HASH_SECRET=change_me           # secret HMAC distinct par environnement
LOG_LEVEL=warning
RUN_MIGRATIONS=true                # migrations au démarrage du service backend

# --- Sessions / Sanctum / CORS (web et api sous le même domaine parent) ----------
SESSION_DOMAIN=.exemple.ci
SANCTUM_STATEFUL_DOMAINS=exemple.ci,www.exemple.ci
CORS_ALLOWED_ORIGINS=https://exemple.ci,https://www.exemple.ci

# --- Base de données (le service db est interne, aucun port publié) -----------
DB_DATABASE=protectici
DB_USERNAME=protectici
DB_PASSWORD=change_me

# --- File d'attente ----------------------------------------------------------
QUEUE_CONNECTION=database

# --- E-mail (Resend) / newsletter --------------------------------------------
MAIL_FROM_ADDRESS=noreply@exemple.ci
RESEND_API_KEY=change_me
NEWSLETTER_RESEND_SYNC=false
RESEND_AUDIENCE_ID=

# --- Anti-spam Cloudflare Turnstile -------------------------------------------
TURNSTILE_ENABLED=true
TURNSTILE_SECRET_KEY=change_me
# Secret partagé web <-> API (rendu serveur Next : seau de limitation distinct). Même valeur des deux côtés ; générer avec `openssl rand -hex 32`.
SSR_SHARED_SECRET=change_me

# --- Géocodage OSM --------------------------------------------------------------
NOMINATIM_USER_AGENT="ProtectIci/1.0 (contact: contact@exemple.ci)"

# --- Stockage S3-compatible (Cloudflare R2) ---------------------------------------
MEDIA_DISK=s3
DOCUMENTS_DISK=s3-private
AWS_ACCESS_KEY_ID=change_me
AWS_SECRET_ACCESS_KEY=change_me
AWS_DEFAULT_REGION=auto
AWS_BUCKET=protectici-media
AWS_PRIVATE_BUCKET=protectici-documents
AWS_ENDPOINT=https://change_me.r2.cloudflarestorage.com
AWS_URL=https://media.exemple.ci

# --- Web : arguments de BUILD (NEXT_PUBLIC_*, publics, jamais de secret) ---------
NEXT_PUBLIC_API_URL=https://api.exemple.ci
NEXT_PUBLIC_SITE_URL=https://exemple.ci
NEXT_PUBLIC_ALLOW_INDEXING=1       # 1 en production seulement ; 0 en staging
NEXT_PUBLIC_TURNSTILE_SITE_KEY=change_me
NEXT_PUBLIC_MEDIA_ORIGINS=https://media.exemple.ci
# API_INTERNAL_URL et SESSION_COOKIE_NAME sont fixés dans le compose (runtime).
